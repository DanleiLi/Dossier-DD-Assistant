# Supabase project settings
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SERVICE_KEY=sb_secret_replace_me

# Database connection strings; use the direct URL for Alembic migrations
DATABASE_URL=postgresql://postgres:your-password@your-host:5432/postgres
DATABASE_URL_DIRECT=postgresql://postgres:your-password@your-direct-host:5432/postgres

# Model credentials
OPENAI_API_KEY=replace_me
ANTHROPIC_API_KEY=replace_me

# Optional; defaults to text-embedding-3-small and 1536 dimensions
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMS=1536
